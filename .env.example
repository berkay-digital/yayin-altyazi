# Copy to .env and fill in. Only the auth secret and one translation backend are required.

# --- Auth (required) ---
# Public address of the app, used for auth callbacks and cookies.
BETTER_AUTH_URL=http://localhost:3000
# Random string, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Set to "closed" to stop new sign-ups once your own account exists.
# SIGNUP=closed

# --- Database ---
# Postgres connection string. Leave unset to use PGlite (embedded Postgres) stored in PGLITE_DIR.
# DATABASE_URL=postgres://user:password@localhost:5432/yayinaltyazi
# PGLITE_DIR=.data/pglite

# --- Translation (set Claude or an OpenAI-compatible API) ---
ANTHROPIC_API_KEY=
# Optional second key. When set, it serves first and ANTHROPIC_API_KEY takes over while it is rate limited or out of credit.
# ANTHROPIC_API_KEY_PRIMARY=
# CLAUDE_MODEL=claude-haiku-5-5

# Used only when no Anthropic key is set. Any OpenAI-compatible server, local ones included.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=
# Extra JSON merged into each chat completion request body.
# AI_EXTRA_BODY={"temperature":0.2}

# --- Proxy (optional) ---
# Header your reverse proxy puts the client address in, used for rate limits. Behind Cloudflare: cf-connecting-ip.
# Unset means X-Forwarded-For.
# CLIENT_IP_HEADER=cf-connecting-ip

# --- Bot protection (optional) ---
# Cloudflare Turnstile on sign-up and sign-in. Both keys are needed.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Contact (optional) ---
# Shown on the sign-in page for password resets (there is no email sending).
# SUPPORT_EMAIL=

# --- Billing (optional, off unless POLAR_ACCESS_TOKEN and POLAR_PRODUCT are set) ---
# With billing on, new accounts get a free trial and then need the paid plan.
# POLAR_ACCESS_TOKEN=
# POLAR_ENV=sandbox
# POLAR_PRODUCT=
# POLAR_WEBHOOK_SECRET=
# PLAN_NAME=Aylık
# PLAN_PRICE=₺99/ay
# TRIAL_MINUTES=180
# FAIR_USE_MINUTES=15000
